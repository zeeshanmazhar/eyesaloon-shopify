<section class="page-width eyesaloon-testimonials{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="eyesaloon-section-heading">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="eyesaloon-testimonials__grid">
    {%- for block in section.blocks -%}
      <figure class="eyesaloon-testimonial" {{ block.shopify_attributes }}>
        {% render 'eyesaloon-rating-stars', rating: block.settings.rating, count: 0 %}
        <blockquote>{{ block.settings.quote }}</blockquote>
        <figcaption>
          {{- block.settings.name -}}
          {%- if block.settings.city != blank -%}, {{ block.settings.city }}{%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Eyesaloon testimonials",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Customers trust Eyesaloon"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Prescription support was clear and the frame fit well."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Eyesaloon customer"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City",
          "default": "Lahore"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 0.5,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Eyesaloon testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "I was nervous ordering glasses online, but their optician actually checked my prescription before it shipped. Fit was perfect.",
            "name": "Ayesha K.",
            "city": "Lahore",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "The WhatsApp confirmation caught an error in my old prescription before it became a problem. That's real support, not just a checkout.",
            "name": "Bilal R.",
            "city": "Karachi",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Real optician, real answers to my questions about lens thickness. No 'master copy' guesswork like other online stores.",
            "name": "Hina S.",
            "city": "Islamabad",
            "rating": 4.5
          }
        }
      ]
    }
  ]
}
{% endschema %}
