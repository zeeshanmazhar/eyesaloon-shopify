<section class="page-width eyesaloon-trust-grid{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {%- if section.settings.heading != blank -%}
    <div class="eyesaloon-section-heading">
      <h2>{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="eyesaloon-trust-grid__grid">
    {%- for block in section.blocks -%}
      <div class="eyesaloon-trust-grid__card" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}
          <span class="eyesaloon-trust-grid__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'eye' -%}
                {{- 'icon-eye.svg' | inline_asset_content -}}
              {%- when 'return' -%}
                {{- 'icon-return.svg' | inline_asset_content -}}
              {%- when 'recycle' -%}
                {{- 'icon-recycle.svg' | inline_asset_content -}}
              {%- when 'truck' -%}
                {{- 'icon-truck.svg' | inline_asset_content -}}
            {%- endcase -%}
          </span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <p class="eyesaloon-trust-grid__card-heading">{{ block.settings.heading }}</p>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="eyesaloon-trust-grid__card-text">{{ block.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Eyesaloon trust grid",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why customers trust Eyesaloon"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "eye", "label": "Eye" },
            { "value": "return", "label": "Return/exchange" },
            { "value": "recycle", "label": "Remake" },
            { "value": "truck", "label": "Delivery" },
            { "value": "none", "label": "None" }
          ],
          "default": "eye"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Real optician fitted"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Every prescription checked before your frame ships."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Eyesaloon trust grid",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "eye",
            "heading": "Real optician fitted",
            "text": "Every prescription checked before your frame ships."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "return",
            "heading": "7-day exchange",
            "text": "Wrong fit or shape? Swap it within a week."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "recycle",
            "heading": "Free Rx remake",
            "text": "If the prescription is off, we remake the lenses free."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "truck",
            "heading": "COD nationwide",
            "text": "Pay when your order arrives, anywhere in Pakistan."
          }
        }
      ]
    }
  ]
}
{% endschema %}
