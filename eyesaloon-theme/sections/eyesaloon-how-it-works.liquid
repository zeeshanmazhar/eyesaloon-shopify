<section class="eyesaloon-how{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="page-width eyesaloon-how__inner">
    <div class="eyesaloon-section-heading">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {% render 'eyesaloon-steps' %}
  </div>
</section>

{% schema %}
{
  "name": "Eyesaloon how it works",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pick a frame, add your prescription details, and confirm everything with our team before lenses are made."
    }
  ],
  "presets": [
    {
      "name": "Eyesaloon how it works"
    }
  ]
}
{% endschema %}
