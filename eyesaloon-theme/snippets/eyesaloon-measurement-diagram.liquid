{% comment %}
  API: render 'eyesaloon-measurement-diagram'
{% endcomment %}
<div class="eyesaloon-measurement">
  <svg class="eyesaloon-measurement__diagram" viewBox="0 0 520 240" role="img" aria-labelledby="EyesaloonMeasurementTitle">
    <title id="EyesaloonMeasurementTitle">{{ 'eyesaloon.measurement.title' | t }}</title>
    <g fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="150" cy="100" r="64" />
      <circle cx="370" cy="100" r="64" />
      <path d="M214 100h92" />
      <path d="M86 100h-66" />
      <path d="M434 100h66" />
    </g>
    <g class="eyesaloon-measurement__arrows" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <path d="M92 194h108M92 194l10-7M92 194l10 7M200 194l-10-7M200 194l-10 7" />
      <path d="M238 194h44M238 194l8-6M238 194l8 6M282 194l-8-6M282 194l-8 6" />
      <path d="M438 194h58M438 194l10-7M438 194l10 7M496 194l-10-7M496 194l-10 7" />
    </g>
    <text x="146" y="181" text-anchor="middle" class="eyesaloon-measurement__diagram-label">{{ 'eyesaloon.measurement.lens_width' | t }}</text>
    <text x="260" y="181" text-anchor="middle" class="eyesaloon-measurement__diagram-label">{{ 'eyesaloon.measurement.bridge' | t }}</text>
    <text x="467" y="181" text-anchor="middle" class="eyesaloon-measurement__diagram-label">{{ 'eyesaloon.measurement.temple' | t }}</text>
  </svg>
</div>
