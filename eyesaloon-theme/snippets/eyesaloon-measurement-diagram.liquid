{% comment %}
  API: render 'eyesaloon-measurement-diagram'
{% endcomment %}
<div class="eyesaloon-measurement">
  <svg class="eyesaloon-measurement__diagram" viewBox="0 0 520 240" role="img" aria-labelledby="EyesaloonMeasurementTitle">
    <title id="EyesaloonMeasurementTitle">{{ 'eyesaloon.measurement.title' | t }}</title>
    <g fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="150" cy="100" r="64" />
      <circle cx="370" cy="100" r="64" />
      <path d="M214 100h92" />
      <path d="M86 100h-66" />
      <path d="M434 100h66" />
    </g>
    <g fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round">
      <path d="M86 190h120M86 190l14-10M86 190l14 10M206 190l-14-10M206 190l-14 10" />
      <path d="M222 190h76M222 190l14-10M222 190l14 10M298 190l-14-10M298 190l-14 10" />
      <path d="M434 190h66M434 190l14-10M434 190l14 10M500 190l-14-10M500 190l-14 10" />
    </g>
    <text x="146" y="220" text-anchor="middle" class="eyesaloon-measurement__diagram-label">{{ 'eyesaloon.measurement.lens_width' | t }}</text>
    <text x="260" y="220" text-anchor="middle" class="eyesaloon-measurement__diagram-label">{{ 'eyesaloon.measurement.bridge' | t }}</text>
    <text x="467" y="220" text-anchor="middle" class="eyesaloon-measurement__diagram-label">{{ 'eyesaloon.measurement.temple' | t }}</text>
  </svg>
</div>
