{% comment %}
  API: render 'eyesaloon-steps'
{% endcomment %}
<ol class="eyesaloon-steps">
  <li class="eyesaloon-step">
    <span class="eyesaloon-step__number">1</span>
    <span class="eyesaloon-step__copy">
      <span class="eyesaloon-step__heading">{{ 'eyesaloon.steps.choose_frame' | t }}</span>
      <span class="eyesaloon-step__text">{{ 'eyesaloon.steps.choose_frame_text' | t }}</span>
    </span>
  </li>
  <li class="eyesaloon-step">
    <span class="eyesaloon-step__number">2</span>
    <span class="eyesaloon-step__copy">
      <span class="eyesaloon-step__heading">{{ 'eyesaloon.steps.send_rx' | t }}</span>
      <span class="eyesaloon-step__text">{{ 'eyesaloon.steps.send_rx_text' | t }}</span>
    </span>
  </li>
  <li class="eyesaloon-step">
    <span class="eyesaloon-step__number">3</span>
    <span class="eyesaloon-step__copy">
      <span class="eyesaloon-step__heading">{{ 'eyesaloon.steps.fit_and_deliver' | t }}</span>
      <span class="eyesaloon-step__text">{{ 'eyesaloon.steps.fit_and_deliver_text' | t }}</span>
    </span>
  </li>
</ol>
