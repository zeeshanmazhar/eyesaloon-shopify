{% liquid
  assign selected_product = block.settings.product
  if selected_product == blank and product != blank
    assign selected_product = product
  endif
  if selected_product == blank and closest.product != blank
    assign selected_product = closest.product
  endif

  assign model_file = selected_product.metafields.eyesaloon.model_3d.value

  if model_file == blank
    assign model_file = selected_product.metafields.eyesaloon.try_on_3d_model.value
  endif

  if model_file == blank
    assign model_file = selected_product.metafields.eyesaloon.tryon_3d_model.value
  endif

  if model_file == blank
    assign model_file = selected_product.metafields.custom.try_on_3d_model.value
  endif

  if model_file == blank
    assign model_file = selected_product.metafields.custom.tryon_3d_model.value
  endif

  if model_file == blank
    assign model_file = selected_product.metafields.custom.model_3d.value
  endif
  assign product_model = selected_product.media | where: 'media_type', 'model' | first
  assign metafield_model_source = blank
  assign product_model_source = blank
  assign model_url = ''
  assign lens_width = selected_product.metafields.eyesaloon.lens_width_mm.value
  assign bridge = selected_product.metafields.eyesaloon.bridge_mm.value
  assign temple = selected_product.metafields.eyesaloon.temple_mm.value
  assign lens_height = selected_product.metafields.eyesaloon.lens_height_mm.value
  assign show_block = false

  if model_file != blank and model_file.media_type == 'model'
    assign metafield_model_source = model_file.sources | where: 'format', 'glb' | first
    assign model_url = metafield_model_source.url
  elsif model_file != blank and model_file.url != blank
    assign model_url = model_file.url
  endif

  if model_url == blank and product_model != blank
    assign product_model_source = product_model.sources | where: 'format', 'glb' | first
    assign model_url = product_model_source.url
  endif

  if model_url == blank and block.settings.model_url != blank
    assign model_url = block.settings.model_url
  endif

  if selected_product != blank and model_url != blank
    assign show_block = true
  elsif request.design_mode
    assign show_block = true
  endif
%}

{% if show_block %}
  <div
    class="eyesaloon-tryon"
    data-eyesaloon-tryon
    {% if selected_product != blank %}data-product-id="{{ selected_product.id }}"{% endif %}
    {% if selected_product != blank %}data-product-url="{{ selected_product.url }}"{% endif %}
    data-build-version="tryon-v17"
    {% if model_url != blank %}data-model-url="{{ model_url }}"{% endif %}
    {% if lens_width != blank %}data-lens-width-mm="{{ lens_width }}"{% endif %}
    {% if bridge != blank %}data-bridge-mm="{{ bridge }}"{% endif %}
    {% if temple != blank %}data-temple-mm="{{ temple }}"{% endif %}
    {% if lens_height != blank %}data-lens-height-mm="{{ lens_height }}"{% endif %}
    data-status-ready="{{ 'tryon.ready_status' | t | escape }}"
    data-status-desktop="{{ 'tryon.desktop_status' | t | escape }}"
    data-status-loading="{{ 'tryon.loading_status' | t | escape }}"
    data-status-camera-permission="{{ 'tryon.camera_permission_status' | t | escape }}"
    data-status-active-camera="{{ 'tryon.active_camera_status' | t | escape }}"
    data-status-model-active="{{ 'tryon.model_active_status' | t | escape }}"
    data-status-model-error="{{ 'tryon.model_error_status' | t | escape }}"
    data-status-no-camera="{{ 'tryon.no_camera_status' | t | escape }}"
    data-status-unsupported="{{ 'tryon.unsupported_status' | t | escape }}"
    data-status-no-model="{{ 'tryon.no_model_status' | t | escape }}"
    data-status-qr-error="{{ 'tryon.qr_error_status' | t | escape }}"
    data-status-tracking-assets-missing="{{ 'tryon.tracking_assets_missing_status' | t | escape }}"
    data-status-runtime-error="{{ 'tryon.runtime_error_status' | t | escape }}"
    data-copy-success="{{ 'tryon.copy_success' | t | escape }}"
    data-copy-error="{{ 'tryon.copy_error' | t | escape }}"
    data-qr-src="{{ 'tryon-qr.js' | asset_url }}"
    data-qr-label="{{ 'tryon.qr_label' | t | escape }}"
    data-runtime-src="{{ 'tryon-runtime.js' | asset_url }}"
    data-renderer-src="{{ 'tryon-renderer.js' | asset_url }}"
    data-tracking-manifest-url="{{ block.settings.tracking_manifest_url | default: 'https://tryon-assets.eyesaloon.com/manifest.json' | escape }}"
  >
    <div class="eyesaloon-tryon__copy">
      <p class="eyesaloon-tryon__eyebrow">{{ 'tryon.eyebrow' | t }}</p>
      <h3 class="eyesaloon-tryon__title">{{ block.settings.heading }}</h3>
      <p class="eyesaloon-tryon__text">{{ block.settings.supporting_text }}</p>
    </div>

    <div class="eyesaloon-tryon__actions">
      <button class="eyesaloon-tryon__button" type="button" aria-haspopup="dialog">
        <span>{{ block.settings.button_label }}</span>
      </button>

      <span class="eyesaloon-tryon__chip">{{ 'tryon.privacy_chip' | t }}</span>
    </div>

    {% if request.design_mode and model_url == blank %}
      <p class="eyesaloon-tryon__hint">
        {{ 'tryon.missing_model' | t }}
      </p>
    {% endif %}

    <div
      class="eyesaloon-tryon-modal"
      data-eyesaloon-tryon-modal
      role="dialog"
      aria-modal="true"
      hidden
    >
      <button class="eyesaloon-tryon-modal__backdrop" type="button" data-eyesaloon-tryon-close>
        <span class="visually-hidden">{{ 'tryon.close' | t }}</span>
      </button>

      <div
        class="eyesaloon-tryon-modal__panel"
        aria-label="{{ block.settings.heading | escape }}"
      >
        <div class="eyesaloon-tryon-modal__header">
          <div>
            <p class="eyesaloon-tryon__eyebrow">{{ 'tryon.modal_eyebrow' | t }}</p>
            <h3 class="eyesaloon-tryon-modal__title">{{ block.settings.heading }}</h3>
          </div>

          <button class="eyesaloon-tryon-modal__close" type="button" data-eyesaloon-tryon-close>
            <span aria-hidden="true">x</span>
            <span class="visually-hidden">{{ 'tryon.close' | t }}</span>
          </button>
        </div>

        <div class="eyesaloon-tryon-modal__stage" data-eyesaloon-tryon-stage>
          <video
            class="eyesaloon-tryon-modal__video"
            data-eyesaloon-tryon-video
            playsinline
            muted
            hidden
          ></video>

          <canvas
            class="eyesaloon-tryon-modal__model"
            data-eyesaloon-tryon-renderer
            aria-hidden="true"
            hidden
          ></canvas>

          <canvas
            class="eyesaloon-tryon-modal__canvas"
            data-eyesaloon-tryon-canvas
            aria-hidden="true"
            hidden
          ></canvas>

          <div class="eyesaloon-tryon-modal__frame" aria-hidden="true">
            <span class="eyesaloon-tryon-modal__lens eyesaloon-tryon-modal__lens--left"></span>
            <span class="eyesaloon-tryon-modal__bridge"></span>
            <span class="eyesaloon-tryon-modal__lens eyesaloon-tryon-modal__lens--right"></span>
          </div>

          <p class="eyesaloon-tryon-modal__status" data-eyesaloon-tryon-status>
            {{ 'tryon.ready_status' | t }}
          </p>

          <div class="eyesaloon-tryon__desktop" data-eyesaloon-tryon-desktop hidden>
            <div
              class="eyesaloon-tryon-modal__qr"
              data-eyesaloon-tryon-qr
              aria-label="{{ 'tryon.qr_label' | t | escape }}"
              hidden
            ></div>
            <button class="eyesaloon-tryon-modal__action" type="button" data-eyesaloon-tryon-copy hidden>
              {{ 'tryon.copy_link' | t }}
            </button>
          </div>
        </div>

        <div class="eyesaloon-tryon-modal__footer">
          <button class="eyesaloon-tryon-modal__action" type="button" data-eyesaloon-tryon-camera hidden>
            {{ 'tryon.camera_button' | t }}
          </button>
          <span class="eyesaloon-tryon__chip">{{ 'tryon.fit_chip' | t }}</span>
          <span class="eyesaloon-tryon__chip">{{ 'tryon.privacy_chip' | t }}</span>
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Try-on",
  "target": "section",
  "stylesheet": "tryon.css",
  "javascript": "tryon.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "text",
      "id": "model_url",
      "label": "3D model URL override"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the fit before you order"
    },
    {
      "type": "text",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "Preview frame scale and lens width with a private on-device try-on."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try on"
    },
    {
      "type": "text",
      "id": "tracking_manifest_url",
      "label": "Tracking manifest URL",
      "default": "https://tryon-assets.eyesaloon.com/manifest.json"
    }
  ]
}
{% endschema %}
